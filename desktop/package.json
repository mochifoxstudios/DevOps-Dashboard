{
  "name": "devops-local-desktop",
  "version": "1.00.1",
  "private": true,
  "description": "DevOps Local — Electron desktop wrapper that runs the dashboard + local agent as one app.",
  "main": "main.js",
  "author": { "name": "Mochi Fox Games", "email": "aimanaxp@gmail.com" },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mochifoxgames.devopslocal",
    "productName": "DevOps Local",
    "copyright": "Copyright © 2026 Mochi Fox Games",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      {
        "from": "../agent",
        "to": "agent",
        "filter": [
          "**/*",
          "!**/.env", "!**/.ai-keys.json", "!**/.salt", "!**/.brain-state.json",
          "!**/.audit*", "!**/.github-queue.json",
          "!test/**", "!fixtures/**"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": ["index.html", "css/**/*", "js/**/*", "LICENSE", "README.md"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevOps Local"
    },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "mac": {
      "target": [ { "target": "dmg", "arch": ["x64", "arm64"] } ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [ { "target": "AppImage", "arch": ["x64"] } ],
      "category": "Development"
    }
  }
}
